# These values are bundled into the public frontend. Never put secrets here.
# Replace with your public OpenAI-compatible API URL. Use /api/v1 when you
# configure a same-origin reverse proxy.
VITE_API_BASE_URL=https://api.example.org/v1

# Optional external destinations. Leave blank to keep links within this site.
# When set, Chat links open this public sign-in entry URL before the chat.
VITE_AUTH_URL=
VITE_CHAT_URL=
VITE_TELEGRAM_BOT_URL=
VITE_SUPPORT_EMAIL=
